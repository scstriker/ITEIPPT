{
  "name": "iteislides-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "npm --prefix ../src run build && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist-check",
    "smoke:workerd": "npm --prefix ../src run build && tsx scripts/workerdSmoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  }
}
