# Gemini API key is read by local proxy service only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Local API proxy listening port.
API_PROXY_PORT="8787"

# Vite dev server forwards /api/* to this target.
API_PROXY_TARGET="http://127.0.0.1:8787"

# Optional: override Gemini upstream base URL.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Optional: model used by POST /api/plan.
GEMINI_PLAN_MODEL="gemini-2.5-flash"

# Optional: model used by POST /api/generate-content.
GEMINI_CONTENT_MODEL="gemini-2.5-flash"
