{
  "name": "iteislides-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "proxy:dev": "tsx --env-file=.env ../functions/src/dev/localServer.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "gate:phase1": "tsx scripts/phase1Gate.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:local": "playwright test -c playwright.local-backend.config.ts",
    "e2e:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
